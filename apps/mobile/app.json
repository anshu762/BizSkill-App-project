{
  "expo": {
    "name": "BizSkills",
    "slug": "bizskills",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "bizskills",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "BizSkills uses your photos to add your profile and portfolio images."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bizskills.mobile"
    },
    "android": {
      "package": "com.bizskills.mobile"
    }
  }
}

