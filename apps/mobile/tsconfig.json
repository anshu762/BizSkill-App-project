{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "typeRoots": ["./src/@types", "./node_modules/@types"],
    "jsx": "react-native",
    "moduleResolution": "bundler",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ]
}

