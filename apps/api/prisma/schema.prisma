generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SkillCategory {
  GRAPHIC_DESIGN
  SOCIAL_MEDIA
  PHOTOGRAPHY
  WEBSITE
  MARKETING
  BRANDING
  FINANCE
  PITCH_DECK
  CONTENT
  OTHER
}

enum BusinessStage {
  IDEA
  BUILDING
  LAUNCHED
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  EXPERT
}

enum ExchangeStatus {
  PENDING
  ACCEPTED
  REJECTED
  COMPLETED
  CANCELLED
}

enum TeamCategory {
  SCHOOL_STARTUP
  COMPETITION
  BUSINESS_FAIR
  PERSONAL_PROJECT
}

enum TeamStage {
  FORMING
  ACTIVE
  COMPLETED
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model User {
  id               String            @id @default(uuid()) @db.Uuid
  name             String
  email            String            @unique
  passwordHash     String            @map("password_hash")
  avatar           String?
  bio              String?
  age              Int?
  location         String?
  bizCoins         Int               @default(100) @map("biz_coins")
  hasOnboarded     Boolean           @default(false) @map("has_onboarded")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  businessProfile  BusinessProfile?
  skills           Skill[]
  refreshTokens    RefreshToken[]
  posts            Post[]
  postLikes        PostLike[]
  comments         PostComment[]
  notifications    Notification[]
  teamMemberships  TeamMember[]
  ownedTeams       Team[]            @relation("TeamOwner")
  requestsSent     ExchangeRequest[] @relation("RequestSender")
  requestsReceived ExchangeRequest[] @relation("RequestRecipient")
  transactionsSent Transaction[]    @relation("TransactionSender")
  transactionsRecv Transaction[]    @relation("TransactionReceiver")
  reviewsGiven     Review[]         @relation("Reviewer")
  reviewsReceived  Review[]         @relation("Reviewee")
  followers        Follow[]         @relation("FollowedUser")
  following        Follow[]         @relation("FollowerUser")
  sentMessages     Message[]        @relation("MessageSender")
  receivedMessages Message[]        @relation("MessageReceiver")
  teamApplications TeamApplication[]

  @@map("users")
}

model Follow {
  id          String   @id @default(uuid()) @db.Uuid
  followerId  String   @map("follower_id") @db.Uuid
  followingId String   @map("following_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  follower    User     @relation("FollowerUser", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("FollowedUser", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@map("follows")
}

model Transaction {
  id               String          @id @default(uuid()) @db.Uuid
  fromUserId       String          @map("from_user_id") @db.Uuid
  toUserId         String          @map("to_user_id") @db.Uuid
  amount           Int
  type             TransactionType
  description      String
  relatedExchangeId String?        @map("related_exchange_id")
  createdAt        DateTime        @default(now()) @map("created_at")
  fromUser         User            @relation("TransactionSender", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser           User            @relation("TransactionReceiver", fields: [toUserId], references: [id], onDelete: Cascade)

  @@map("transactions")
}

enum TransactionType {
  EXCHANGE_REWARD
  COIN_DEDUCT
  BONUS
}

model Review {
  id         String   @id @default(uuid()) @db.Uuid
  reviewerId String   @map("reviewer_id") @db.Uuid
  revieweeId String   @map("reviewee_id") @db.Uuid
  exchangeId String   @map("exchange_id") @db.Uuid
  rating     Int
  comment    String?
  createdAt  DateTime @default(now()) @map("created_at")
  reviewer   User     @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewee   User     @relation("Reviewee", fields: [revieweeId], references: [id], onDelete: Cascade)
  exchange   ExchangeRequest @relation(fields: [exchangeId], references: [id])

  @@unique([exchangeId, reviewerId])
  @@map("reviews")
}

model BusinessProfile {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String         @unique @map("user_id") @db.Uuid
  businessName    String         @map("business_name")
  industry        SkillCategory
  description     String?
  stage           BusinessStage
  website         String?
  instagramHandle String?        @map("instagram_handle")
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("business_profiles")
}

model Skill {
  id                String            @id @default(uuid()) @db.Uuid
  userId            String            @map("user_id") @db.Uuid
  title             String
  category          SkillCategory
  description       String?
  level             SkillLevel
  coinValue         Int               @map("coin_value")
  isOffering        Boolean           @default(true) @map("is_offering")
  isActive          Boolean           @default(true) @map("is_active")
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  offeredRequests   ExchangeRequest[] @relation("OfferedSkill")
  requestedRequests ExchangeRequest[] @relation("RequestedSkill")

  @@map("skills")
}

model ExchangeRequest {
  id               String         @id @default(uuid()) @db.Uuid
  fromUserId       String         @map("from_user_id") @db.Uuid
  toUserId         String         @map("to_user_id") @db.Uuid
  skillOfferedId   String         @map("skill_offered_id") @db.Uuid
  skillRequestedId String         @map("skill_requested_id") @db.Uuid
  message          String?
  coinsOffered     Int            @map("coins_offered")
  status           ExchangeStatus @default(PENDING)
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  fromUser         User           @relation("RequestSender", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser           User           @relation("RequestRecipient", fields: [toUserId], references: [id], onDelete: Cascade)
  skillOffered     Skill          @relation("OfferedSkill", fields: [skillOfferedId], references: [id], onDelete: Cascade)
  skillRequested   Skill          @relation("RequestedSkill", fields: [skillRequestedId], references: [id], onDelete: Cascade)
  reviews          Review[]

  @@map("exchange_requests")
}

model Post {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  content   String
  type      String        @default("UPDATE")
  image     String?
  imageUrl  String?       @map("image_url")
  likes     Int           @default(0)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  postLikes PostLike[]
  comments  PostComment[]

  @@map("posts")
}

model PostLike {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("post_likes")
}

model PostComment {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("post_comments")
}

model Team {
  id          String          @id @default(uuid()) @db.Uuid
  name        String
  description String?
  ownerId     String          @map("owner_id") @db.Uuid
  category    TeamCategory    @default(PERSONAL_PROJECT)
  stage       TeamStage       @default(FORMING)
  isPublic    Boolean         @default(true) @map("is_public")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  owner       User            @relation("TeamOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     TeamMember[]
  roles       TeamRole[]

  @@map("teams")
}

model TeamMember {
  id        String     @id @default(uuid()) @db.Uuid
  teamId    String     @map("team_id") @db.Uuid
  userId    String     @map("user_id") @db.Uuid
  role      String     @default("MEMBER")
  joinedAt  DateTime   @default(now()) @map("joined_at")
  team      Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@map("team_members")
}

model TeamRole {
  id            String            @id @default(uuid()) @db.Uuid
  teamId        String            @map("team_id") @db.Uuid
  title         String
  description   String?
  skillsNeeded  String[]          @map("skills_needed")
  isOpen        Boolean           @default(true) @map("is_open")
  createdAt     DateTime          @default(now()) @map("created_at")
  team          Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  applications  TeamApplication[]

  @@map("team_roles")
}

model TeamApplication {
  id           String            @id @default(uuid()) @db.Uuid
  teamRoleId   String            @map("team_role_id") @db.Uuid
  applicantId  String            @map("applicant_id") @db.Uuid
  message      String?
  status       ApplicationStatus @default(PENDING)
  createdAt    DateTime          @default(now()) @map("created_at")
  teamRole     TeamRole          @relation(fields: [teamRoleId], references: [id], onDelete: Cascade)
  applicant    User              @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  @@map("team_applications")
}

model Message {
  id         String   @id @default(uuid()) @db.Uuid
  senderId   String   @map("sender_id") @db.Uuid
  receiverId String   @map("receiver_id") @db.Uuid
  content    String
  isRead     Boolean  @default(false) @map("is_read")
  createdAt  DateTime @default(now()) @map("created_at")
  sender     User     @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User     @relation("MessageReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  type      String
  message   String
  link      String?
  isRead    Boolean  @default(false) @map("is_read")
  relatedId String?  @map("related_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}
