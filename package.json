{
  "name": "bizskills",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.34.1",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "concurrently -n api,mobile -c cyan,magenta \"npm run dev --prefix apps/api\" \"pnpm --filter mobile dev\"",
    "dev:api": "npm run dev --prefix apps/api",
    "dev:mobile": "pnpm --filter mobile dev",
    "typecheck": "pnpm -r typecheck",
    "build:api": "npm run build --prefix apps/api",
    "prisma:generate": "npm run prisma:generate --prefix apps/api",
    "prisma:migrate": "npm run prisma:migrate --prefix apps/api"
  },
  "devDependencies": {
    "concurrently": "9.1.2",
    "typescript": "5.4.5"
  }
}
