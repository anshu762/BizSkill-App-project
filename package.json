{
  "name": "bizskills",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "concurrently -n api,mobile -c cyan,magenta \"pnpm --filter api dev\" \"pnpm --filter mobile dev\"",
    "dev:api": "pnpm --filter api dev",
    "dev:mobile": "pnpm --filter mobile dev",
    "typecheck": "pnpm -r typecheck",
    "build:api": "pnpm --filter api build",
    "prisma:generate": "pnpm --filter api prisma:generate",
    "prisma:migrate": "pnpm --filter api prisma:migrate"
  },
  "devDependencies": {
    "concurrently": "9.1.2",
    "typescript": "5.4.5"
  }
}
